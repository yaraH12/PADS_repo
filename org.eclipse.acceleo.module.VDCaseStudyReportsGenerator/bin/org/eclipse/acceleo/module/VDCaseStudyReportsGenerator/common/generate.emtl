          <body xsi:type="ocl.ecore:StringLiteralExp" stringSymbol="&#xA;&#x9;&#x9;&#x9;&#xA;"/>
          <body xsi:type="mtl:LetBlock">
            <body xsi:type="mtl:LetBlock">
              <body xsi:type="mtl:LetBlock">
                <body xsi:type="mtl:LetBlock">
                  <body xsi:type="mtl:LetBlock">
                    <body xsi:type="mtl:LetBlock">
                      <body xsi:type="ocl.ecore:StringLiteralExp" stringSymbol="&#x9;&#x9;&#x9;"/>
                      <body xsi:type="ocl.ecore:VariableExp" name="factorsRAS" eType="/15/Sequence(String)" referredVariable="/0/generateElement/%.2/%.6/%.13/%/%/%/%/%/factorsRAS.1"/>
                      <body xsi:type="ocl.ecore:StringLiteralExp" stringSymbol="&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;\subsection{Category Success Ratios}&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;\begin{table}&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;\centering&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;\caption{Score Ratio table for each factor with total nb of requirements and achieved nb of requirements}&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;\begin{tabular}{|l|c|c|c|}&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;\hline&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;Category &amp; Total Reqs &amp; Successful Reqs &amp; Success Ratio (\%) \\&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;\hline&#xA;"/>
                      <body xsi:type="mtl:ForBlock">
                        <body xsi:type="mtl:LetBlock">
